# Godot : cache d import et etat editeur (regenere par --import)
.godot/
.import/
*.import.tmp

# Harnais de test : sorties et captures
.testout/

# Packs bruts (1,3 Go de zips, > 100 Mo par fichier : refuses par GitHub).
# Ils restent sur le poste ; le README liste quoi retelecharger.
raw_assets/*
!raw_assets/README.txt
!raw_assets/.gdignore

# Exports et binaires
export/
*.exe
*.pck
*.apk
*.aab

# Local
.claude/settings.local.json
*.log
Thumbs.db
.DS_Store
