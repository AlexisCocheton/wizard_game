# Godot : cache d import et etat editeur (regenere par --import)
.godot/
.import/
*.import.tmp

# Harnais de test : sorties et captures
.testout/

# Packs bruts (1,3 Go de zips, > 100 Mo par fichier : refuses par GitHub).
# Ils restent sur le poste ; le README liste quoi retelecharger.
raw_assets/*
!raw_assets/README.txt
!raw_assets/.gdignore

# Exports et binaires
export/
*.exe
*.pck
*.apk
*.aab

# Local
.claude/settings.local.json
*.log
Thumbs.db
.DS_Store

# Profil Chrome du projet : il porte le COOKIE DE SESSION craftpix, pose a la
# main par le testeur (tools/assets/fetch_craftpix.py). Un cookie de session
# dans un depot pousse sur GitHub, c est exactement ce qui fuit.
.browser_profile/
