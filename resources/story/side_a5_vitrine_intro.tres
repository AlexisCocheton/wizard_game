[resource]
script = ExtResource("1_jxc88")
id = &"side_a5_vitrine_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Une aile de la galerie porte un seul mot : NURI. Des arbres sous verre, un cor de berger, une grange. Au centre, une gorgone d or sur un socle."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "C est ton ile, mage. Rangee avant d etre finie."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Ils ont deja l etiquette. Il ne manque que la date."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "La gorgone tourne la tete vers le mage, et le verre de la vitrine se fend."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Ne la regarde pas trop longtemps. Les pieces de musee n aiment pas qu on les touche."
}])
