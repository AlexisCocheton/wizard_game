[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_3i55y"]

[resource]
script = ExtResource("1_3i55y")
id = &"lvl_07_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "L Enclume se fend en deux comme un moule de fonte. Dedans, pas de coeur : un contrat, grave dans le metal."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "C est ma signature. Et au-dessus, une autre, que je n ai jamais vue. Petite et soignee."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Donc il recevait des ordres, lui aussi."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "J ai travaille vingt ans dans un atelier comme ca, la-haut. Le patron fabrique ce qu on lui commande."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Le pentacle a cinq branches. Quatre portent un nom. J ai compte."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "... Quand est-ce que tu as compte ?"
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "L enfant ne repond pas. Il regarde deja ailleurs."
}])
