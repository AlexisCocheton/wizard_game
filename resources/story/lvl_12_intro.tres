[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_rbekp"]

[resource]
script = ExtResource("1_rbekp")
id = &"lvl_12_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Un temple de cristal ou chaque chose est protegee par une autre. Au fond, tres loin, une forme qui ne descend pas."
}, {
"portrait": &"demon",
"side": "right",
"speaker": "Un demon",
"text": "Tu es celui qui est revenu en arriere. Approche, si tu peux."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Tu ne viens pas te battre ?"
}, {
"portrait": &"demon",
"side": "right",
"speaker": "Un demon",
"text": "Je ne me bats jamais. Je PROTEGE. C est une fonction, pas un caractere."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Tu protegeais mon royaume de quoi, exactement ?"
}, {
"portrait": &"demon",
"side": "right",
"speaker": "Un demon",
"text": "Rien du tout. Je protegeais l ordre. On ne m a pas dit ce qu il contenait."
}])
