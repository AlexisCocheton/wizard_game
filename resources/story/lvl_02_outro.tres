[resource]
script = ExtResource("1_y878n")
id = &"lvl_02_outro"
scene_background = "talk_village"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "La Reine gorgone s effondre au milieu de la place. Les sorts du mage se degelent d un coup. Les gens du village, eux, restent en pierre."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Ce qu une gorgone fige, sa mort le libere. Pas eux. Quelqu un les a figes avant elle."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Ils sont bien comme ca. Ils n ont plus peur."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "... Ou est ton maire, petit ?"
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Dans la grange. Il s y cache depuis trois jours."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Trois jours. Avant meme l attaque. Et lui n est pas en pierre."
}])
