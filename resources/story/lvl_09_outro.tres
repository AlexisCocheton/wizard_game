lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Gardien s effondre. Son armure s ouvre comme une ecorce : dedans, du bois mort, et plantee comme une echarde, une plaque de metal noir."
}, {
"portrait": &"guardian",
"side": "right",
"speaker": "Le Gardien",
"text": "... pas... voulu..."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Il n est pas devenu fou. On lui a mis quelque chose dedans."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Vu la soudure, c est du travail d en haut. Sky Lands. Je connais le style, j en viens."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Alors on monte ?"
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "On monte. Accrochez-vous a ce qui est visse."
}])
