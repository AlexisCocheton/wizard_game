[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_d6ccw"]

[resource]
script = ExtResource("1_d6ccw")
id = &"lvl_09_intro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Bougez pas, touchez a rien, et surtout ne montez pas. Il manque une valve, deux ailerons et ma patience."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Combien de temps ?"
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Le temps qu il faut. Vous, dehors. Moi, dessous."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Les arbres, au fond de la clairiere, s ecartent d eux-memes."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "C est le Gardien ! C est lui qui protege la foret, il va nous aider !"
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Petit... il marche sur les arbres, pas entre."
}])
