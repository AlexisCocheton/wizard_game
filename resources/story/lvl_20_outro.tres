[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_fv6nh"]

[resource]
script = ExtResource("1_fv6nh")
id = &"lvl_20_outro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "La derniere arriere-garde tombe sans un mot. Aucune n a recule d un pas, et aucune n a tenu plus d une minute."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Il ne les a pas postes pour me battre. Il les a postes pour gagner une heure."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "On ne fait pas ca quand on fuit un ennemi ?"
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "On fait ca quand on fuit un creancier. Un ennemi, on le combat. Un creancier, on le retarde."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Au fond de la cour, un escalier descend, et une lumiere rouge remonte."
}])
