[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_2knk7"]

[resource]
script = ExtResource("1_2knk7")
id = &"lvl_13_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Au centre du monde demoniaque, le pentacle. Devant sa porte, une silhouette que le mage connait."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "La Reine gorgone. Je l ai brisee dans le village de l enfant."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Ici, on recolle les statues. Elle garde la porte. Derriere, Malyk ramasse ce qui a deja servi."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Malyk ?"
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Celui qui porte les ordres aux seigneurs. Il mange ce qu il appelle. Les seigneurs n ont jamais lu l ordre : ils l ont RECU de lui."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "J ai deja vu ca. Un atelier ou personne n est le patron : ca veut dire que le patron n habite pas l atelier."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Alors Malyk n est qu un coursier de plus. Je suis descendu pour rien."
}])
