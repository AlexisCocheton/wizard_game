[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_ao0mt"]

[resource]
script = ExtResource("1_ao0mt")
id = &"lvl_01_outro"
scene_background = "talk_glade"
lines = Array[Dictionary]([{
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Tu les as tous fait tomber ! Meme le grand ! Comment on fait ca ?"
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "On va vite. Plus vite qu eux. C est tout ce que je sais encore faire."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le plus grand d entre eux porte un cadran a la place du coeur. Les aiguilles tournent encore."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Chronos. L huissier des delais. Il etait deja la, la premiere fois, quand Nox est tombee."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Alors va vite jusqu a mon village. Il y en a plein la-bas. Plein."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "... Des gnomes qui attaquent un village. Les gnomes ne font pas ca."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Tu viens ?"
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Je viens. Reste derriere moi et ne me lache pas."
}])
