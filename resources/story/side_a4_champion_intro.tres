[resource]
script = ExtResource("1_vf7y5")
id = &"side_a4_champion_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "L arene de sable noir est vide. Au centre, une chaine plus grosse que les autres retient un guerrier en armure d or."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Le champion de Kaltek. Il le gardait pour les jours ou il fallait gagner devant du monde."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Il n y a plus personne pour regarder."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Il y a toujours quelqu un pour regarder. Ici, c est meme a ca qu on reconnait le patron."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "La chaine cede d elle-meme, comme si on avait attendu que le mage arrive."
}])
