[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_qummk"]

[resource]
script = ExtResource("1_qummk")
id = &"side_squire_outro"
scene_background = "talk_path"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Lutin archer dore tombe du toit d en face, son arc d or brise en deux."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "J etais garde du port. Une epee ne sert a rien contre ce qui tire d en haut, alors j ai appris l arc."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Et maintenant que le port est vide ?"
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "Maintenant je n ai plus de port. Si tu veux, je tire a ta place, et toi tu gardes ta magie pour ce qui compte."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Ce qui compte arrive vite. Tire juste."
}])
