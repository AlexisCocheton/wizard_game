[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_qummk"]

[resource]
script = ExtResource("1_qummk")
id = &"side_squire_outro"
scene_background = "talk_path"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Lutin archer dore tombe du toit d en face, son arc d or brise en deux."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "La nuit ou le port s est vide par le haut, j etais la, avec mon epee. Elle n a touche personne."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "J ai appris l arc apres. Trop tard pour les six cents. Assez tot pour celui-la."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Tu n as pas fui. Tu es parti chercher ce qui te manquait cette nuit-la."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "Le port est toujours vide, mage. Mais plus personne ne le garde pour eux."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors on peut le laisser derriere nous. Ce qui compte arrive vite. Tire juste."
}])
