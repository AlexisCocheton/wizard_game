[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_r4va7"]

[resource]
script = ExtResource("1_r4va7")
id = &"lvl_03_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Reliquaire s ouvre en tombant. Dedans, les registres de l ossuaire, intacts : une colonne par ile, une ligne par annee."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Les trois dernieres annees, on n a plus compte des morts. On les a COMMANDES."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Ils ne vont pas nous effacer par haine. Ils vont nous effacer pour faire du STOCK."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Du stock pour quoi ?"
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "On ne range pas des morts en colonnes si on ne compte pas s en servir tous ensemble."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Il y en a un qui nous regarde. Au fond. Il ne vient pas."
}])
