[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_u8pfl"]

[resource]
script = ExtResource("1_u8pfl")
id = &"side_a2_atelier_intro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Mon ancien atelier est sur l ile d a cote. Vingt ans d etabli. Je veux voir ce qu ils en ont fait."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "On n a pas le temps des souvenirs."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Ce n est pas un souvenir, mage. Si on fabriquait des soudures noires quelque part la-haut, c etait chez nous."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Devant la porte de l atelier, une tour de bois peinte en or. Tout ce qui s en approche brille d un halo."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Elle protege les autres. Comme une maman."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors on eteint d abord la lumiere, et ensuite la tour."
}])
