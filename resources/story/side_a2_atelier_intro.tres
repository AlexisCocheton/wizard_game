[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_u8pfl"]

[resource]
script = ExtResource("1_u8pfl")
id = &"side_a2_atelier_intro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Mon ancien atelier est sur l ile d a cote. Vingt ans d etabli. Je veux voir ce qu ils en ont fait."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "On n a pas le temps des souvenirs."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Ce n est pas un souvenir, mage. L oeil pris dans nos cordages, je l ai reconnu. C est moi qui en ai dessine le modele."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Devant la porte de l atelier, un oeil aile peint en or tourne en spirale. D autres yeux sortent de l atelier et se rangent autour de lui."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Il brille comme une piece neuve."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Il voit venir mes sorts. Alors on le fatigue : un oeil qui esquive finit toujours par cligner."
}])
