[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_f1ce4"]

[resource]
script = ExtResource("1_f1ce4")
id = &"side_a2_atelier_outro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Gardien-totem dore se fend. Sous la dorure, le bois brut d un totem de port, taille a la main, avec une marque d atelier."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "C est un des miens. Je l ai taille pour proteger les quais. Quelqu un l a repeint en or et l a retourne."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Retourne. Comme le Gardien de la foret."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "On ne dore pas une piece pour qu elle tienne mieux. On la dore pour que le client la reconnaisse."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Alors il y a un client. Et il aime l or."
}])
