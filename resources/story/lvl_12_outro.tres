[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_abmd2"]

[resource]
script = ExtResource("1_abmd2")
id = &"lvl_12_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le cercle s eteint, et tout ce qu il protegeait meurt d un coup, sans avoir ete touche."
}, {
"portrait": &"demon",
"side": "right",
"speaker": "Un demon",
"text": "... je n ai pas lu... personne ne lit..."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Quatre seigneurs. Quatre contrats. Et pas un seul qui sache ce qu il signait."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Bienvenue en enfer, mage. C est une administration."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors le pentacle. Tout de suite."
}])
