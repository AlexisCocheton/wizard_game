[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_sby6d"]

[resource]
script = ExtResource("1_sby6d")
id = &"side_bluewitch_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le temple de cristal tient encore. Au fond, sous un cristal bleu, une jeune femme en robe d azur, debout, les yeux ouverts. Elle ne respire pas."
}, {
"portrait": &"bluewitch",
"side": "right",
"speaker": "L apprentie d azur",
"text": "Maitre... Elle porte ma robe. Elle a mon visage."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "C est toi, la premiere fois. Tu es morte a Nox, la derniere nuit. Je ne te l ai jamais dit."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Ici, on ne garde que ce qui servira plus tard. Si ta premiere boucle est sous verre, mage, quelqu un compte s en resservir."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Devant le cristal, un chevalier en armure d or se redresse. Le premier sort qui le touche disparait dans son armure."
}])
