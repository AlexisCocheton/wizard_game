[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_n7i0t"]

[resource]
script = ExtResource("1_n7i0t")
id = &"side_fairy_intro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Au-dessus de l eau trouble des fosses, la fee vole plus bas qu elle ne l a jamais fait. Elle connait chaque tombe."
}, {
"portrait": &"fairy",
"side": "right",
"speaker": "La fee",
"text": "Avant, ces tombes etaient a moi. Je veillais sur les morts d en bas, et je me posais sur leurs pierres."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "C est pour ca que tu ne te poses plus jamais ?"
}, {
"portrait": &"fairy",
"side": "right",
"speaker": "La fee",
"text": "Plus jamais. Ici, le sol mange. Tout ce qui touche cette eau finit par y prendre racine."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors on va lui couper l appetit."
}])
