[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_l2pf5"]

[resource]
script = ExtResource("1_l2pf5")
id = &"side_a1_mesure_intro"
scene_background = "talk_glade"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Au sortir du village, un son de cor traverse la foret de Nuri. Toujours la meme note, toujours le meme pas."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "C est le cor des bergers. Mais les bergers sont en pierre, comme les autres."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors quelqu un d autre en joue. Et tout ce qui marche dans cette foret marche a son rythme."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Une armee qui suit une mesure, petit, c est une armee qui a un chef."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "On va le chercher ?"
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "On va le faire taire. Reste derriere moi."
}])
