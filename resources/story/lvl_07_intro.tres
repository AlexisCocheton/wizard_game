[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_1fmuv"]

[resource]
script = ExtResource("1_1fmuv")
id = &"lvl_07_intro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Une forge sans forgeron. Les marteaux tombent tout seuls, en cadence, sur des choses qui ne sont pas du metal."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Je connais cette cadence. C est la meme que le corniste, dans ta foret."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Le Gardien avait une plaque dans la poitrine. Elle a ete faite ici."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Vharn ne te repondra pas. Il n a jamais rien dit a personne, meme quand il m a fait signer."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors il encaissera. J ai le temps."
}])
