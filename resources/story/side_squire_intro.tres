[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_aqtui"]

[resource]
script = ExtResource("1_aqtui")
id = &"side_squire_intro"
scene_background = "talk_path"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Haute-Nacelle, a nouveau. L ecuyer s arrete au bout du quai, devant une guerite dont la porte pend."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "C etait mon poste. Huit gardes pour tout le port, et moi au bout du quai, avec une epee."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Une fleche se plante dans le quai, a un pas du mage. Elle vient d en haut, du toit d un entrepot."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "A terre ! Celui d en face tire sur tout ce qui bouge sur les quais. Et lui, il est en or."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Un archer dore sur les toits d un port vide. Quelqu un tient a ce que personne n y revienne."
}, {
"portrait": &"soldier",
"side": "right",
"speaker": "L ecuyer",
"text": "Moi, j y reviens. Ce qui tire d en haut, je le descends."
}])
