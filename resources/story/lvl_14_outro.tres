[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_uq5ki"]

[resource]
script = ExtResource("1_uq5ki")
id = &"lvl_14_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Les gardiens de la galerie tombent sans bruit, comme des pieces qu on range. On laisse passer le mage en visiteur."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Ca ne se defend pas parce que ca ne vaut rien. On ne met pas de garde devant ses vieux outils."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Le Gardien de la foret ne valait rien ?"
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Toi non plus, mage. Moi non plus. C est reposant, d une certaine facon."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "L enfant ne dit plus rien depuis le pentacle. Il marche devant."
}])
