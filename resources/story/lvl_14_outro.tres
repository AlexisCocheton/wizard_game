lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Personne n est venu defendre la galerie. On les laisse passer d une salle a l autre comme on laisse passer des visiteurs."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Ca ne se defend pas parce que ca ne vaut rien. On ne met pas de garde devant ses vieux outils."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Le Gardien de la foret ne valait rien."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Toi non plus, mage. Moi non plus. C est reposant, d une certaine facon."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "L enfant ne dit plus rien depuis le pentacle. Il marche devant."
}])
