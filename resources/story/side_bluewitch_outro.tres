[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_lbxgj"]

[resource]
script = ExtResource("1_lbxgj")
id = &"side_bluewitch_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Chevalier du vide dore se disperse en poussiere d or. Le cristal se fend, et la jeune femme ouvre les yeux."
}, {
"portrait": &"",
"side": "right",
"speaker": "L apprentie d azur",
"text": "Qui etes-vous ? Vous me regardez comme si on se connaissait."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Dans une autre vie, je t ai appris a tenir un sort. Dans celle-ci, tu ne me dois rien."
}, {
"portrait": &"",
"side": "right",
"speaker": "L apprentie d azur",
"text": "Alors je choisis. Je combats a votre place, maitre. Et vous me direz comment ca a fini, la premiere fois."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "... Mal. C est pour ca qu on recommence."
}])
