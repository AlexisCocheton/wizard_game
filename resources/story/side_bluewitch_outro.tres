[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_lbxgj"]

[resource]
script = ExtResource("1_lbxgj")
id = &"side_bluewitch_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le Chevalier du vide dore se disperse en poussiere d or. Le cristal se fend, et la jeune femme qu il gardait s efface comme une buee."
}, {
"portrait": &"bluewitch",
"side": "right",
"speaker": "L apprentie d azur",
"text": "Vous m avez reprise comme apprentie en sachant comment ca avait fini pour moi."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Je t ai reprise pour que ca ne finisse pas pareil. Dans celle-ci, tu ne me dois rien."
}, {
"portrait": &"bluewitch",
"side": "right",
"speaker": "L apprentie d azur",
"text": "Alors c est vous qui me devez quelque chose. Comment ca a fini, la premiere fois ? Tout, pas seulement moi."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "... Mal. C est pour ca qu on recommence."
}])
