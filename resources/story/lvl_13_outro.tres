[resource]
script = ExtResource("1_j2tnj")
id = &"lvl_13_outro"
scene_background = "talk_shrine"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le pentacle qui tient le monde demoniaque se fend en cinq morceaux, et le monde avec lui."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Ce n est pas nous qui l avons casse."
}, {
"portrait": &"skeleton_king",
"side": "right",
"speaker": "Le Roi squelette",
"text": "Non. On nous RETIRE. Comme on retire une piece du plateau."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Ne lachez pas ma main."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Petit, ta main est froide comme le puits."
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "La chute ne va pas vers le bas."
}])
