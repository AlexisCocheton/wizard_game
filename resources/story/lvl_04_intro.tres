[gd_resource type="Resource" script_class="DialogueDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_def.gd" id="1_4pu6b"]

[resource]
script = ExtResource("1_4pu6b")
id = &"lvl_04_intro"
scene_background = "talk_greattree"
lines = Array[Dictionary]([{
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Au centre du cimetiere de bordure, un cercle deja trace et des Pretres qui chantent depuis assez longtemps pour que la pierre soit chaude."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Nous arrivons trop tard. On ne l arrete plus."
}, {
"portrait": &"rat",
"side": "right",
"speaker": "Le Rat pilote",
"text": "Alors on repart."
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Non. On reste, et on regarde ce qui sort. C est la seule chose que je sois venu chercher."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Et si ce qui sort nous voit ?"
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors nous aurons une adresse."
}])
