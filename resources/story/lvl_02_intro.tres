[resource]
script = ExtResource("1_tfhs8")
id = &"lvl_02_intro"
scene_background = "talk_village"
lines = Array[Dictionary]([{
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "C est la ! La maison sous le grand arbre, c est chez moi !"
}, {
"portrait": &"",
"side": "left",
"speaker": "",
"text": "Le village est debout. Ses gens aussi : en pierre, figes au milieu d un geste."
}, {
"portrait": &"child",
"side": "right",
"speaker": "L Enfant",
"text": "Ils ne repondent pas. Pourquoi ils ne repondent pas ?"
}, {
"portrait": &"mage_grave",
"side": "left",
"speaker": "Le Mage",
"text": "Des gorgones sont passees. Il en reste. Si l une d elles regarde mes sorts, ils se figeront dans ma main."
}, {
"portrait": &"mage",
"side": "left",
"speaker": "Le Mage",
"text": "Alors on les abat en premier. Et regarde les autres : ils marchent au pas. Quelqu un leur bat la mesure."
}])
