exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"shatter_burst"
sfx_key = &"impact_heavy"
major_upgrades = Array[ExtResource("2_io0mp")]([SubResource("Resource_io0mp"), SubResource("Resource_obxma")])
