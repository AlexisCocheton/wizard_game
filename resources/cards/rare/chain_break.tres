"key": &"knockback",
"op": "set",
"param": &"residue_dps",
"value": 4.0
}, {
"key": &"knockback",
"op": "set",
"param": &"residue_duration",
"value": 4.0
}])
prices = Array[Dictionary]([{
"axis": &"force",
"op": "axis",
"pct": -0.4
}])

[sub_resource type="Resource" id="Resource_obxma"]
script = ExtResource("2_io0mp")
id = &"chaines_pesantes"
title = "Chaines pesantes"
description = "Les chaines restent au sol : ralentit de 50 % pendant 3 s (effet de glace)"
modifiers = Array[Dictionary]([{
"duration": 3.0,
"key": &"ground_zone",
"magnitude": 0.0,
"op": "add_effect",
"params": {
&"slow_pct": 50.0
},
"radius": 190.0
}])
prices = Array[Dictionary]([{
"axis": &"force",
"op": "axis",
"pct": -0.5
}])

[resource]
script = ExtResource("2_bbtto")
id = &"chain_break"
display_name = "Rupture de chaine"
description = "18 degats de VENT en zone, puis repousse violemment tout ce qui reste debout."
rarity = 1
base_cast_time = 1.4
targeting = 1
element = 10
tags = Array[int]([])
effects = Array[ExtResource("1_kki6v")]([SubResource("Resource_bbtto")])
