[ext_resource type="Script" path="res://scripts/data/major_upgrade_def.gd" id="2_io0mp"]

[sub_resource type="Resource" id="Resource_bbtto"]
script = ExtResource("1_kki6v")
key = &"knockback"
magnitude = 18.0
duration = 0.0
radius = 190.0
params = {
&"push": 260.0
}

[sub_resource type="Resource" id="Resource_io0mp"]
script = ExtResource("2_io0mp")
id = &"eclats"
title = "Eclats"
description = "Les eclats restent plantes : 4 degats de VENT par seconde pendant 4 s"
