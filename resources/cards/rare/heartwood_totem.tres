copies_in_starter = 0
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"spirit_gold"
sfx_key = &"stone_shove"
major_upgrades = Array[ExtResource("2_ryls7")]([SubResource("Resource_ryls7"), SubResource("Resource_apqj6")])
