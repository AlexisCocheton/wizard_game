[resource]
script = ExtResource("2_kcara")
id = &"terrain_brambles"
display_name = "Ronces"
description = "Fait pousser des ronces qui restent jusqu a la fin du combat : elles ralentissent de 35 pourcent et infligent 2 degats de NATURE par seconde."
