exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"stone_peak"
sfx_key = &"stone_shove"
major_upgrades = Array[ExtResource("2_ggs2f")]([SubResource("Resource_ggs2f"), SubResource("Resource_1y4hb")])
