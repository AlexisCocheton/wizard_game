"factor": 1.8,
"field": "radius",
"key": &"build_wall",
"op": "scale"
}, {
"key": &"build_wall",
"op": "set",
"param": &"blocks_flyers",
"value": true
}])
prices = Array[Dictionary]([{
"axis": &"cast",
"op": "axis",
"pct": -0.4
}, {
"axis": &"duration",
"op": "axis",
"pct": -0.25
}])

[sub_resource type="Resource" id="Resource_1y4hb"]
script = ExtResource("2_ggs2f")
id = &"mur_de_ronces"
title = "Mur de ronces"
description = "Des ronces le bordent : qui le longe est ralenti de 30 % et perd 5 PV par seconde"
