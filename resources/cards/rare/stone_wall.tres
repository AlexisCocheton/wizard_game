"duration": 20.0,
"key": &"ground_zone",
"magnitude": 5.0,
"op": "add_effect",
"params": {
&"slow_pct": 30.0
},
"radius": 230.0
}])
prices = Array[Dictionary]([{
"axis": &"duration",
"op": "axis",
"pct": -0.5
}])

[resource]
script = ExtResource("2_1ifur")
id = &"stone_wall"
