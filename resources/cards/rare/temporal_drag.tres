[ext_resource type="Script" path="res://scripts/data/spell_card.gd" id="2_gr3u8"]

[sub_resource type="Resource" id="Resource_gr3u8"]
script = ExtResource("1_rnomm")
key = &"slow_enemy_gauge"
magnitude = 40.0
duration = 5.0
radius = 0.0
params = {}

[sub_resource type="Resource" id="Resource_dgi5v"]
script = ExtResource("2_dgi5v")
id = &"arret_du_temps"
title = "Arret du temps"
description = "Trois arrets : les monstres sont quasi figes (-90 %) 1 s, toutes les 2,5 s"
modifiers = Array[Dictionary]([{
"field": "magnitude",
"key": &"slow_enemy_gauge",
"op": "set",
"value": 90.0
}, {
"field": "duration",
"key": &"slow_enemy_gauge",
"op": "set",
"value": 1.0
}, {
"delay": 2.5,
"factor": 1.0,
"op": "repeat"
}, {
"delay": 5.0,
"factor": 1.0,
"op": "repeat"
}])
prices = Array[Dictionary]([{
"axis": &"cast",
"op": "axis",
"pct": -0.4
}])

[sub_resource type="Resource" id="Resource_cbpsy"]
script = ExtResource("2_dgi5v")
id = &"double_entrave"
title = "Double entrave"
description = "L entrave revient 6 s plus tard : deux ralentissements de suite"
modifiers = Array[Dictionary]([{
"delay": 6.0,
"factor": 1.0,
"op": "repeat"
}])
prices = Array[Dictionary]([{
"axis": &"slow",
"op": "axis",
"pct": -0.4
}])

[resource]
script = ExtResource("2_gr3u8")
id = &"temporal_drag"
display_name = "Entrave temporelle"
description = "Ralentit tous les ennemis de 40 pourcent pendant 5 s."
rarity = 1
base_cast_time = 1.4
targeting = 0
element = 3
tags = Array[int]([4])
effects = Array[ExtResource("1_rnomm")]([SubResource("Resource_gr3u8")])
copies_in_starter = 0
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"timemagic"
sfx_key = &"time_slow"
major_upgrades = Array[ExtResource("2_dgi5v")]([SubResource("Resource_dgi5v"), SubResource("Resource_cbpsy")])
