"pct": -1.0
}])

[resource]
script = ExtResource("2_yowyj")
id = &"ice_wall"
display_name = "Mur de glace"
description = "Mur de glace permanent de 70 PV : les monstres le contournent, et ceux qui craignent le froid le frappent moins fort."
