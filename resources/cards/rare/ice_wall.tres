"key": &"ground_zone",
"magnitude": 0.0,
"op": "add_effect",
"params": {
&"slow_pct": 50.0
},
"radius": 230.0
}])
prices = Array[Dictionary]([{
"axis": &"hp",
"op": "axis",
"pct": -0.4
}])

[sub_resource type="Resource" id="Resource_m76hc"]
script = ExtResource("2_0577e")
