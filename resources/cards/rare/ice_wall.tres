[sub_resource type="Resource" id="Resource_0577e"]
script = ExtResource("2_0577e")
id = &"mur_de_givre"
title = "Mur de givre"
description = "Le froid du mur ralentit de 50 % tout ce qui l approche pendant 8 s"
