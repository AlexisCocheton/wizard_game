[gd_resource type="Resource" script_class="SpellCard" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/effect_spec.gd" id="1_oxs7y"]
[ext_resource type="Script" path="res://scripts/data/major_upgrade_def.gd" id="2_g8iuj"]
[ext_resource type="Script" path="res://scripts/data/spell_card.gd" id="2_w6rc1"]

[sub_resource type="Resource" id="Resource_w6rc1"]
script = ExtResource("1_oxs7y")
key = &"place_terrain"
magnitude = 0.0
duration = 0.0
radius = 150.0
params = {
&"kind": "pit",
&"vuln_mult": 1.3
}

[sub_resource type="Resource" id="Resource_g8iuj"]
script = ExtResource("2_g8iuj")
id = &"gouffre"
title = "Gouffre"
description = "Incassable et plus profond (x2 degats, -40 % vitesse), mais comble en 12 s"
modifiers = Array[Dictionary]([{
"key": &"place_terrain",
"op": "set",
"param": &"unbreakable",
"value": true
}, {
"field": "duration",
"key": &"place_terrain",
"op": "set",
"value": 12.0
}, {
"key": &"place_terrain",
"op": "set",
"param": &"vuln_mult",
"value": 2.0
}, {
"key": &"place_terrain",
"op": "set",
"param": &"slow_pct",
"value": 40.0
}])
prices = Array[Dictionary]([{
"axis": &"area",
"op": "axis",
"pct": -0.2
}])

[sub_resource type="Resource" id="Resource_ac8p0"]
script = ExtResource("2_g8iuj")
id = &"fosse_aux_pieux"
title = "Fosse aux pieux"
description = "Des pieux jaillissent : etourdi 1 s a la pose, puis 6 degats de NATURE par seconde"
modifiers = Array[Dictionary]([{
"field": "magnitude",
"key": &"place_terrain",
"op": "set",
"value": 6.0
}, {
"duration": 1.0,
"key": &"stun_zone",
"magnitude": 0.0,
"op": "add_effect",
"params": {},
"radius": 150.0
}])
prices = Array[Dictionary]([{
"axis": &"amplify",
"op": "axis",
"pct": -0.5
}])

[resource]
script = ExtResource("2_w6rc1")
id = &"terrain_pit"
display_name = "Fosse"
description = "Creuse une fosse qui reste jusqu a la fin du combat : les monstres qui s y trouvent subissent 30 pourcent de degats en plus."
rarity = 2
base_cast_time = 1.7
targeting = 1
element = 9
tags = Array[int]([])
effects = Array[ExtResource("1_oxs7y")]([SubResource("Resource_w6rc1")])
copies_in_starter = 0
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"orb_magenta"
sfx_key = &"earth_dig"
major_upgrades = Array[ExtResource("2_g8iuj")]([SubResource("Resource_g8iuj"), SubResource("Resource_ac8p0")])
