"op": "add_effect",
"spec": SubResource("Resource_1qyuh")
}])
prices = Array[Dictionary]([{
"axis": &"hp",
"op": "axis",
"pct": -0.5
}])

[resource]
script = ExtResource("2_kr1a0")
id = &"bastion"
display_name = "Bastion"
description = "Mur permanent de 120 PV. Il ne disparait pas : les monstres doivent le briser."
rarity = 2
base_cast_time = 2.0
targeting = 1
element = 9
tags = Array[int]([])
effects = Array[ExtResource("1_h0hek")]([SubResource("Resource_kr1a0")])
copies_in_starter = 0
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"dome_bastion"
sfx_key = &"stone_heavy"
major_upgrades = Array[ExtResource("2_sdp0f")]([SubResource("Resource_sdp0f"), SubResource("Resource_pksk3")])
