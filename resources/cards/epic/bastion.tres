&"permanent": true,
&"thickness": 60.0,
&"wall_hp": 120.0
}

[sub_resource type="Resource" id="Resource_sdp0f"]
script = ExtResource("2_sdp0f")
id = &"forteresse"
title = "Forteresse"
description = "Incassable et infranchissable, meme en volant, mais il tombe en 15 s"
modifiers = Array[Dictionary]([{
"key": &"build_wall",
"op": "set",
"param": &"permanent",
"value": false
}, {
"field": "duration",
"key": &"build_wall",
"op": "set",
"value": 15.0
}, {
"key": &"build_wall",
"op": "set",
"param": &"unbreakable",
"value": true
}, {
"key": &"build_wall",
"op": "set",
"param": &"blocks_flyers",
"value": true
}])
prices = Array[Dictionary]([{
"axis": &"cast",
"op": "axis",
"pct": -0.3
}])

[sub_resource type="Resource" id="Resource_1qyuh"]
