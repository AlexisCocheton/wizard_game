"axis": &"area",
"op": "axis",
"pct": -0.4
}, {
"axis": &"cast",
"op": "axis",
"pct": -0.3
}])

[sub_resource type="Resource" id="Resource_2nax2"]
script = ExtResource("2_5dgcp")
id = &"onde_de_froid"
title = "Onde de froid"
description = "Le froid se propage : la zone part a x0,3, s etend a x2 puis se replie"
modifiers = Array[Dictionary]([{
"key": &"ground_zone",
"op": "set",
"param": &"grow_start",
"value": 0.3
}, {
"key": &"ground_zone",
"op": "set",
"param": &"grow_peak",
"value": 2.0
}])
prices = Array[Dictionary]([{
"axis": &"slow",
"op": "axis",
"pct": -0.4
}])

[resource]
script = ExtResource("2_1iesi")
id = &"deep_freeze"
display_name = "Gel profond"
