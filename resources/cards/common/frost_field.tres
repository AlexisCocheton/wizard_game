[gd_resource type="Resource" script_class="SpellCard" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/effect_spec.gd" id="1_t6wfx"]
[ext_resource type="Script" path="res://scripts/data/spell_card.gd" id="2_i1x5g"]
[ext_resource type="Script" path="res://scripts/data/major_upgrade_def.gd" id="2_vum32"]

[sub_resource type="Resource" id="Resource_i1x5g"]
script = ExtResource("1_t6wfx")
key = &"ground_zone"
magnitude = 1.0
duration = 5.0
radius = 180.0
params = {
&"slow_pct": 50.0
}

[sub_resource type="Resource" id="Resource_vum32"]
