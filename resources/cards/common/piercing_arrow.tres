"key": &"pierce_line",
"op": "duplicate",
"params": {
&"offset_px": 130.0
}
}])
prices = Array[Dictionary]([{
"axis": &"damage",
"op": "axis",
"pct": -0.3
}, {
"axis": &"cast",
"op": "axis",
"pct": -0.3
}])

[sub_resource type="Resource" id="Resource_rmcwe"]
