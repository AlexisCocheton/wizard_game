description = "Le froid gagne tout le terrain : monstres -20 % de vitesse 6 s"
modifiers = Array[Dictionary]([{
"duration": 6.0,
"key": &"slow_enemy_gauge",
"magnitude": 20.0,
"op": "add_effect",
"params": {},
"radius": 0.0
}])
prices = Array[Dictionary]([{
"axis": &"area",
"op": "axis",
"pct": -0.5
}])

[sub_resource type="Resource" id="Resource_u15ay"]
script = ExtResource("2_r2ltc")
id = &"grelons"
title = "Grelons"
description = "Des grelons s abattent sur tout le terrain : 8 impacts de 14 degats de GLACE"
modifiers = Array[Dictionary]([{
"duration": 4.0,
"key": &"meteor_storm",
"magnitude": 14.0,
"op": "add_effect",
"params": {
&"impacts": 8
},
"radius": 90.0
}])
prices = Array[Dictionary]([{
"axis": &"slow",
"op": "axis",
"pct": -0.4
}, {
"axis": &"duration",
"op": "axis",
"pct": -0.25
}])

[resource]
script = ExtResource("2_wd8s3")
id = &"frost_rain"
display_name = "Pluie de givre"
description = "Tres grande zone : 2 degats de GLACE par seconde et ralentissement de 30 pourcent pendant 8 s."
