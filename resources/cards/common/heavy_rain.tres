[gd_resource type="Resource" script_class="SpellCard" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/effect_spec.gd" id="1_fruqw"]
[ext_resource type="Script" path="res://scripts/data/major_upgrade_def.gd" id="2_okslb"]
[ext_resource type="Script" path="res://scripts/data/spell_card.gd" id="3_yuxsn"]

[sub_resource type="Resource" id="Resource_fruqw"]
script = ExtResource("1_fruqw")
key = &"global_rain"
magnitude = 1.0
duration = 10.0
radius = 0.0
params = {
&"interval": 2.0
}

[sub_resource type="Resource" id="Resource_okslb"]
script = ExtResource("2_okslb")
id = &"averse_soudaine"
title = "Averse soudaine"
description = "La pluie tombe presque aussitot"
modifiers = Array[Dictionary]([{
"factor": 0.25,
"op": "cast_time"
}])
prices = Array[Dictionary]([{
"axis": &"discard",
"op": "axis",
"pct": -1.0
}])

[sub_resource type="Resource" id="Resource_yuxsn"]
script = ExtResource("2_okslb")
id = &"pluie_battante"
title = "Pluie battante"
description = "Le deluge repousse les monstres : ils font demi-tour 1,5 s"
modifiers = Array[Dictionary]([{
"duration": 1.5,
"key": &"reverse_enemies",
"magnitude": 0.0,
"op": "add_effect",
"params": {},
"radius": 0.0
}])
prices = Array[Dictionary]([{
"axis": &"cast",
"op": "axis",
"pct": -0.4
}])

[resource]
script = ExtResource("3_yuxsn")
id = &"heavy_rain"
display_name = "Pluie abondante"
description = "Une pluie tombe sur tout le terrain pendant 10 s : 1 degat d EAU a chaque monstre toutes les 2 s."
rarity = 0
base_cast_time = 2.5
targeting = 0
element = 8
tags = Array[int]([])
effects = Array[ExtResource("1_fruqw")]([SubResource("Resource_fruqw")])
copies_in_starter = 0
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"rain_streaks"
sfx_key = &"drip_frost"
major_upgrades = Array[ExtResource("2_okslb")]([SubResource("Resource_okslb"), SubResource("Resource_yuxsn")])
