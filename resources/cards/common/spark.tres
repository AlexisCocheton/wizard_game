[ext_resource type="Script" path="res://scripts/data/major_upgrade_def.gd" id="2_hpl8g"]

[sub_resource type="Resource" id="Resource_0tbp0"]
script = ExtResource("1_013tf")
key = &"damage_single"
magnitude = 15.0
duration = 0.0
radius = 0.0
params = {}

[sub_resource type="Resource" id="Resource_hpl8g"]
script = ExtResource("2_hpl8g")
id = &"arc_electrique"
title = "Arc electrique"
description = "La cible porte une marque de 6 : a sa mort elle saute au voisin, -1 par saut"
modifiers = Array[Dictionary]([{
"duration": 0.0,
"key": &"electric_mark",
"magnitude": 6.0,
"op": "add_effect",
"params": {
&"decay": 1.0,
&"jump_range": 300.0
},
"radius": 0.0
}])
prices = Array[Dictionary]([{
"axis": &"damage",
"op": "axis",
"pct": -0.3
}])

[sub_resource type="Resource" id="Resource_diwr1"]
script = ExtResource("2_hpl8g")
id = &"choc"
title = "Choc"
description = "L etincelle etourdit 0,6 s la cible et ses voisins proches"
modifiers = Array[Dictionary]([{
"duration": 0.6,
"key": &"stun_zone",
"magnitude": 0.0,
"op": "add_effect",
"params": {},
"radius": 110.0
}])
