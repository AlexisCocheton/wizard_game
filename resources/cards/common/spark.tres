base_cast_time = 0.45
targeting = 3
element = 7
tags = Array[int]([])
effects = Array[ExtResource("1_013tf")]([SubResource("Resource_0tbp0")])
copies_in_starter = 2
exile_after_cast = false
is_passive = false
speed_threshold = 100
fx_key = &"spark_burst"
sfx_key = &"zap_spark"
major_upgrades = Array[ExtResource("2_hpl8g")]([SubResource("Resource_hpl8g"), SubResource("Resource_diwr1")])
