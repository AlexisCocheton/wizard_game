"axis": &"damage",
"op": "axis",
"pct": -0.45
}, {
"axis": &"cast",
"op": "axis",
"pct": -0.25
}])

[resource]
script = ExtResource("2_0tbp0")
id = &"spark"
display_name = "Etincelle"
description = "15 degats de FOUDRE sur une cible. Tres rapide a lancer."
