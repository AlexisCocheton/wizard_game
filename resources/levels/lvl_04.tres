exploration_deck = Array[ExtResource("15_2hq1a")]([ExtResource("16_3ggyh"), ExtResource("16_3ggyh"), ExtResource("16_3ggyh"), ExtResource("17_4ad6v"), ExtResource("17_4ad6v"), ExtResource("18_c48fb"), ExtResource("18_c48fb"), ExtResource("19_hnn0k"), ExtResource("19_hnn0k"), ExtResource("20_7yug6"), ExtResource("20_7yug6"), ExtResource("21_1pqnj"), ExtResource("21_1pqnj"), ExtResource("22_3u6xu"), ExtResource("23_d7imv"), ExtResource("23_d7imv"), ExtResource("24_w12a2")])
