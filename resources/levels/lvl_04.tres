[resource]
script = ExtResource("26_7yug6")
id = &"lvl_04"
display_name = "Le Grand Appel"
act = 2
subtitle = "Le rituel reussit"
intro_text = "Tu arrives trop tard : le cercle est deja trace et les Pretres chantent. Tu ne peux plus empecher la Grande Invocation. Tu peux seulement etre la quand la porte s ouvrira, pour voir ce qui en sortira."
outro_text = "Les goules croyaient invoquer un allie. Elles ont invoque un PROPRIETAIRE. Le Grand Cimetiere a ete annexe en une nuit. Le Pretre qui dirigeait le rituel, ecrase par ce qu il a fait venir, t a appris a rappeler ce qui est deja parti — puis t a montre la porte, encore ouverte."
intro_story = &"lvl_04_intro"
outro_story = &"lvl_04_outro"
terrain = "sand"
backdrop = "act2_graveyard"
waves = Array[ExtResource("27_1pqnj")]([SubResource("Resource_ujq15"), SubResource("Resource_3c44l"), SubResource("Resource_1shp4"), SubResource("Resource_nen0k"), SubResource("Resource_sti6l"), SubResource("Resource_n0k5c")])
enemy_pool = Array[ExtResource("1_qw7h0")]([ExtResource("2_dec1e"), ExtResource("3_mx6g5"), ExtResource("4_amgrg"), ExtResource("5_yn11s"), ExtResource("6_th6to"), ExtResource("7_3c44l"), ExtResource("8_nxc80"), ExtResource("9_amgrg"), ExtResource("10_6lwi4"), ExtResource("11_ujq15"), ExtResource("12_3c44l"), ExtResource("13_1shp4"), ExtResource("14_nen0k"), ExtResource("15_sti6l"), ExtResource("16_n0k5c")])
exploration_deck = Array[ExtResource("17_1ou2m")]([ExtResource("18_qy046"), ExtResource("18_qy046"), ExtResource("18_qy046"), ExtResource("18_qy046"), ExtResource("19_5lu5t"), ExtResource("19_5lu5t"), ExtResource("20_2hq1a"), ExtResource("20_2hq1a"), ExtResource("21_3ggyh"), ExtResource("22_4ad6v"), ExtResource("22_4ad6v"), ExtResource("23_c48fb")])
objectives = Array[ExtResource("26_ju63x")]([SubResource("Resource_nxc80"), SubResource("Resource_amgrg"), SubResource("Resource_6lwi4")])
