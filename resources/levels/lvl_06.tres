[resource]
script = ExtResource("26_h4335")
id = &"lvl_06"
display_name = "La Cour brisee"
act = 3
subtitle = "Une guerre civile ou tu n es qu un passant"
intro_text = "Les seigneurs demoniaques s entretuent pour savoir qui portera la faute du Grand Appel rate. Personne ne t attend. Tout le monde te tuera quand meme, en passant."
outro_text = "Le Chevalier du vide qui gardait le cadran s est rendu. Il t a enseigne le geste des gardiens : effacer ce qui a ete inscrit sur une creature. Sur le cadran, tu as lu une adresse."
terrain = "sand"
waves = Array[ExtResource("27_ytel0")]([SubResource("Resource_3upq3"), SubResource("Resource_dkk8l"), SubResource("Resource_1nu7g"), SubResource("Resource_dmiyi"), SubResource("Resource_4qi0c"), SubResource("Resource_26vll")])
