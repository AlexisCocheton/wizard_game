[resource]
script = ExtResource("22_s8hpk")
id = &"lvl_21"
display_name = "Le pentacle"
act = 3
subtitle = "Il ne fuyait pas devant toi"
intro_text = "Au fond de Tombol, une salle et un pentacle qui tourne. Le Roi squelette est accule contre lui et il ne se bat pas : il te dit qu il a signe pour SAUVER son royaume, et que ce qui monte de ce puits ne negocie pas. L adversaire de cette salle n est pas le roi. C est le sceau."
outro_text = "Le sceau se fend et ce qui passe au travers n a pas d yeux, et sait pourtant exactement ou tout le monde se tient. Ils savent que tu as recule le temps : tout le monde, en bas, le sait. C est pour CA qu ils avancent si vite maintenant. Tu n as pas change la fin, tu as change la date. Le roi demande une place dans le groupe : il n a plus de royaume a perdre. On descend."
intro_story = &"lvl_21_intro"
outro_story = &"lvl_21_outro"
terrain = "sand"
backdrop = "act2_graveyard"
waves = Array[ExtResource("23_belrn")]([SubResource("Resource_1k6lh"), SubResource("Resource_wosyd"), SubResource("Resource_y52nd"), SubResource("Resource_h3ov4")])
enemy_pool = Array[ExtResource("1_nrv4l")]([ExtResource("2_qoti4"), ExtResource("3_e42nv"), ExtResource("4_2bcqe"), ExtResource("5_sw1il"), ExtResource("6_ia684"), ExtResource("7_jxcgh"), ExtResource("8_1k6lh"), ExtResource("9_wosyd"), ExtResource("10_y52nd"), ExtResource("11_vpd72")])
exploration_deck = Array[ExtResource("11_h3ov4")]([ExtResource("12_0n865"), ExtResource("12_0n865"), ExtResource("13_ngw11"), ExtResource("13_ngw11"), ExtResource("13_ngw11"), ExtResource("13_ngw11"), ExtResource("14_jablq"), ExtResource("14_jablq"), ExtResource("14_jablq"), ExtResource("16_bret4"), ExtResource("18_vk0ai"), ExtResource("19_cnvpr")])
objectives = Array[ExtResource("21_6gits")]([SubResource("Resource_sw1il"), SubResource("Resource_ia684"), SubResource("Resource_jxcgh")])
levelup_cards = Array[ExtResource("11_h3ov4")]([ExtResource("19_sw1il"), ExtResource("20_ia684"), ExtResource("21_jxcgh")])
objective_rewards = Array[ExtResource("11_h3ov4")]([ExtResource("22_1k6lh"), ExtResource("23_wosyd"), ExtResource("24_y52nd")])
