[resource]
script = ExtResource("23_hkulf")
id = &"lvl_13"
display_name = "Le pentacle brise"
act = 4
subtitle = "Celui qui porte les ordres"
intro_text = "Au centre du monde demoniaque, le pentacle. La Reine gorgone, recollee, en garde la porte ; derriere, Malyk porte les ordres que les seigneurs ont recus sans les lire. Le pentacle tient ce monde, et il n a jamais ete a eux."
