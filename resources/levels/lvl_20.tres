[resource]
script = ExtResource("21_ke38o")
id = &"lvl_20"
display_name = "La cour des rois morts"
act = 3
subtitle = "La vague choisit ta cible"
intro_text = "Une cour de statues, et sous chaque statue un Gardien-totem qui rend ses voisins intouchables. Tu ne choisis plus ou frapper : il faut d abord abattre celui qui protege, et il se protege lui-meme derriere ceux qu il protege."
outro_text = "La derniere arriere-garde tombe sans un mot. Le Roi squelette n a laisse ni message ni piege : il a laisse des gens a mourir pour gagner une heure. On ne fuit pas comme ca devant un poursuivant. On fuit comme ca devant un creancier."
intro_story = &"lvl_20_intro"
outro_story = &"lvl_20_outro"
terrain = "sand"
backdrop = "act2_graveyard"
waves = Array[ExtResource("22_ffhrg")]([SubResource("Resource_m0qgh"), SubResource("Resource_so1u1"), SubResource("Resource_811w5"), SubResource("Resource_h0w5p")])
enemy_pool = Array[ExtResource("1_m5jln")]([ExtResource("2_ofd6q"), ExtResource("3_77re2"), ExtResource("4_81gl4"), ExtResource("5_pd0cl"), ExtResource("6_m0qgh"), ExtResource("7_so1u1"), ExtResource("8_811w5")])
exploration_deck = Array[ExtResource("9_h0w5p")]([ExtResource("10_vj0kn"), ExtResource("10_vj0kn"), ExtResource("10_vj0kn"), ExtResource("10_vj0kn"), ExtResource("11_140t5"), ExtResource("11_140t5"), ExtResource("11_140t5"), ExtResource("12_hb22i"), ExtResource("12_hb22i"), ExtResource("13_8y18n"), ExtResource("13_8y18n"), ExtResource("18_r8wa0"), ExtResource("18_r8wa0"), ExtResource("17_34pj6"), ExtResource("17_34pj6")])
objectives = Array[ExtResource("20_yb17v")]([SubResource("Resource_77re2"), SubResource("Resource_81gl4"), SubResource("Resource_pd0cl")])
levelup_cards = Array[ExtResource("9_h0w5p")]([ExtResource("16_77re2"), ExtResource("17_81gl4"), ExtResource("18_pd0cl")])
