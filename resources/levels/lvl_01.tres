[resource]
script = ExtResource("16_8t5s7")
id = &"lvl_01"
display_name = "Les Marches du Temps"
act = 1
subtitle = "Le matin de la premiere attaque"
intro_text = "Le royaume est tombe. Tu as remonte le temps jusqu ici, le premier matin, pour trouver qui a donne l ordre. Ce ne sont que des gnomes et des lutins — mais ils marchent en colonne, et la vermine ne marche pas en colonne."
outro_text = "Le Gardien a ri en mourant. Il n a jamais voulu de cette guerre : sa tribu a recu un ordre venu de sous la terre, et refuser coutait plus cher qu obeir. Chronos n etait qu un huissier venu verifier les delais."
intro_story = &"lvl_01_intro"
outro_story = &"lvl_01_outro"
terrain = "grass"
backdrop = "act1_sky"
waves = Array[ExtResource("17_smbsg")]([SubResource("Resource_hb77b"), SubResource("Resource_elxgn"), SubResource("Resource_vs6mp")])
enemy_pool = Array[ExtResource("1_vmxm3")]([ExtResource("2_4lqvx"), ExtResource("3_8wkm5"), ExtResource("4_67x60"), ExtResource("5_ckexf"), ExtResource("6_6vmxt"), ExtResource("7_6vmxt"), ExtResource("8_07mnm"), ExtResource("9_hb77b"), ExtResource("7_07mnm"), ExtResource("8_hb77b")])
exploration_deck = Array[ExtResource("9_elxgn")]([ExtResource("10_vs6mp"), ExtResource("10_vs6mp"), ExtResource("10_vs6mp"), ExtResource("10_vs6mp"), ExtResource("11_jmste"), ExtResource("11_jmste"), ExtResource("11_jmste"), ExtResource("12_mjm5p"), ExtResource("12_mjm5p"), ExtResource("13_31cm4"), ExtResource("13_31cm4"), ExtResource("14_8wkm5"), ExtResource("14_8wkm5"), ExtResource("15_67x60"), ExtResource("15_67x60")])
objectives = Array[ExtResource("15_01qir")]([SubResource("Resource_ckexf"), SubResource("Resource_6vmxt"), SubResource("Resource_07mnm")])
