[resource]
script = ExtResource("19_2lmll")
id = &"lvl_17"
display_name = "Les courants"
act = 2
subtitle = "Le mur ne sert plus a rien"
intro_text = "Le dirigeable monte dans les courants et tout ce qui t y attend vole. Les Planogos passent au-dessus des murs, les Oeils se laissent porter et ne vont jamais droit, l Archer ne descend pas du tout. Couvre le ciel ou ne couvre rien."
outro_text = "L Ecumeur du ciel tombe a cote de la nacelle. Le rat le retourne du pied et ne dit rien pendant un moment : sous l aile, la meme soudure noire que dans la poitrine du Gardien. Les Sky Lands ne sont pas sauvages. Elles sont un atelier."
intro_story = &"lvl_17_intro"
outro_story = &"lvl_17_outro"
terrain = "grass"
backdrop = "act1_sky"
waves = Array[ExtResource("20_qqxj5")]([SubResource("Resource_rl3tf"), SubResource("Resource_01pvm"), SubResource("Resource_7tp28"), SubResource("Resource_hf8a2")])
enemy_pool = Array[ExtResource("1_rl3tf")]([ExtResource("2_01pvm"), ExtResource("3_7tp28"), ExtResource("4_hf8a2"), ExtResource("5_jg7in"), ExtResource("6_npl76"), ExtResource("7_rl3tf")])
exploration_deck = Array[ExtResource("8_1r60b")]([ExtResource("9_rxae5"), ExtResource("9_rxae5"), ExtResource("9_rxae5"), ExtResource("9_rxae5"), ExtResource("11_jqiqt"), ExtResource("11_jqiqt"), ExtResource("11_jqiqt"), ExtResource("10_tfajv"), ExtResource("10_tfajv"), ExtResource("12_ak1y0"), ExtResource("12_ak1y0"), ExtResource("16_diyvq"), ExtResource("16_diyvq"), ExtResource("14_odxng"), ExtResource("14_odxng")])
objectives = Array[ExtResource("18_0qchf")]([SubResource("Resource_na325"), SubResource("Resource_d7imv"), SubResource("Resource_44dus")])
