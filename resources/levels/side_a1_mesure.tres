[resource]
script = ExtResource("19_702m4")
id = &"side_a1_mesure"
display_name = "La mesure"
act = 1
subtitle = "Celui qui bat la cadence"
intro_text = "Au village petrifie, les monstres marchaient au pas. Quelque part dans la foret de Nuri, quelqu un leur bat la mesure avec un cor. Trouve-le et fais-le taire : tant qu il joue, tout ce qui descend va plus vite."
