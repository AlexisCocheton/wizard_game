[resource]
script = ExtResource("23_xxgu2")
id = &"lvl_09"
display_name = "Proteger le dirigeable"
act = 1
subtitle = "On ne devient pas fou en six jours"
intro_text = "Le rat pilote repare sous la carcasse et ne veut voir 
personne. Tiens la clairiere le temps qu il faut. Au fond, les arbres s ecartent 
d eux-memes : le Gardien de la foret vient, et il ne marche pas entre les arbres."
outro_text = "Le Gardien s effondre en un tas de bois mort. Dans sa poitrine 
ouverte, plantee comme une echarde, une plaque de metal noir que personne n a taillee 
ici. Il n est pas devenu fou : on lui a mis quelque chose dedans, et la soudure vient 
d en haut."
intro_story = &"lvl_09_intro"
outro_story = &"lvl_09_outro"
terrain = "grass"
backdrop = "act1_sky"
waves = Array[ExtResource("24_7ldq4")]([SubResource("Resource_afr64"), SubResource("Resource_7s4ln"), SubResource("Resource_xlrew"), SubResource("Resource_e2mpa"), SubResource("Resource_pj7ba")])
enemy_pool = Array[ExtResource("1_afr64")]([ExtResource("2_7s4ln"), ExtResource("3_xlrew"), ExtResource("4_e2mpa"), ExtResource("5_pj7ba"), ExtResource("6_hrl8r"), ExtResource("7_c57w3"), ExtResource("8_2bqby"), ExtResource("9_j6y2r"), ExtResource("10_fv56p")])
exploration_deck = Array[ExtResource("11_8xjrd")]([ExtResource("12_olbp5"), ExtResource("12_olbp5"), ExtResource("13_aq1hf"), ExtResource("13_aq1hf"), ExtResource("14_1bsyt"), ExtResource("14_1bsyt"), ExtResource("14_1bsyt"), ExtResource("15_k56tj"), ExtResource("16_htlmc"), ExtResource("16_htlmc"), ExtResource("17_s5lay"), ExtResource("18_f6y4v"), ExtResource("19_caqve"), ExtResource("19_caqve"), ExtResource("20_476h2")])
