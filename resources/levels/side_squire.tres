[resource]
script = ExtResource("15_b1vnr")
id = &"side_squire"
display_name = "L ecuyer du port"
act = 2
subtitle = "Le dernier garde du port vide"
intro_text = "Dans le port vide de Haute-Nacelle, quelqu un tire encore depuis les toits : le dernier garde du port, qui a pose l epee pour l arc. En face de lui, un archer d or tire plus vite et ne s approche jamais : va le chercher avec tes sorts, ou abrite-toi derriere un mur si tu en tires un."
outro_text = ""
intro_story = &"side_squire_intro"
outro_story = &"side_squire_outro"
