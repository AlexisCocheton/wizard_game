id = &"side_squire"
display_name = "L ecuyer du port"
act = 2
subtitle = "Le dernier garde du port vide"
intro_text = "Dans le port vide de Haute-Nacelle, quelqu un tire encore depuis les toits : le dernier garde du port, qui a pose l epee pour l arc. En face de lui, un archer d or tire plus vite et ne s approche jamais. Un mur arrete ses fleches."
