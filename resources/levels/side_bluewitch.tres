[resource]
script = ExtResource("15_2e8rt")
id = &"side_bluewitch"
display_name = "L apprentie d azur"
act = 4
subtitle = "Ce que le cercle protegeait sans savoir quoi"
intro_text = "Au fond du temple d Ymoa, sous un cristal bleu, dort une jeune sorciere que tu as deja connue, dans une autre boucle. Devant elle, un chevalier d or dont l armure avale le premier coup et qui disparait dans le vide."
