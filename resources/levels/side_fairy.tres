[resource]
script = ExtResource("17_hydls")
id = &"side_fairy"
display_name = "La fee des fosses"
act = 3
subtitle = "Elle ne se pose jamais"
intro_text = "Au-dessus de l eau trouble des fosses basses, une fee voltige sans jamais se poser. Sous elle, un champignon d or pousse sur les tombes noyees, et il se fend en deux quand on l abat. Le feu le ronge mieux que tout."
