[resource]
script = ExtResource("22_kj3ap")
id = &"lvl_05"
display_name = "Les forges sous Tombol"
act = 3
subtitle = "Ils ne conquierent pas, ils fabriquent"
intro_text = "Sous la cour des rois, l escalier ne mene pas a une crypte : il mene a une forge qui tourne a plein, rouge de ce qui remonte d en dessous. Tombol enterre ses morts, elle ne coule pas d armures. Ici, rien n est ne : tout a ete coule."
