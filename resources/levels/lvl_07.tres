exploration_deck = Array[ExtResource("17_muspt")]([ExtResource("18_smtlg"), ExtResource("18_smtlg"), ExtResource("18_smtlg"), ExtResource("18_smtlg"), ExtResource("20_ij338"), ExtResource("20_ij338"), ExtResource("20_ij338"), ExtResource("22_6xcos"), ExtResource("22_6xcos"), ExtResource("24_6volu"), ExtResource("24_6volu"), ExtResource("25_jwiqm"), ExtResource("25_jwiqm"), ExtResource("26_vmfe3"), ExtResource("26_vmfe3")])
