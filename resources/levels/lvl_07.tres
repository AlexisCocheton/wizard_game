[resource]
script = ExtResource("31_ksdft")
id = &"lvl_07"
display_name = "Le Metier du Monde"
act = 4
subtitle = "Ce n est pas un monde, c est une matrice"
intro_text = "Une grille de fils tendus entre des etoiles, ou des divinites tissent les evenements. Elles ne sont ni bonnes ni mauvaises : elles sont OCCUPEES. L herbe sous tes pieds est le meme motif qu au premier matin, repete."
outro_text = "Il n y a pas de coupable, il y a un calcul. Ton royaume generait trop de futurs possibles : on l a coupe pour simplifier le motif. Et en remontant le temps, tu es devenu exactement ce que la machine voulait supprimer — le fil qui depasse. Reste a savoir si tu le coupes, si tu prends la place, ou si tu laisses la boucle ouverte."
terrain = "grass"
backdrop = "act4_origin"
waves = Array[ExtResource("32_raevg")]([SubResource("Resource_xuvbo"), SubResource("Resource_lyna4"), SubResource("Resource_2enmq"), SubResource("Resource_qnhb2"), SubResource("Resource_u1eb3"), SubResource("Resource_63ls2")])
enemy_pool = Array[ExtResource("1_xuvbo")]([ExtResource("2_lyna4"), ExtResource("3_2enmq"), ExtResource("4_qnhb2"), ExtResource("5_u1eb3"), ExtResource("6_63ls2"), ExtResource("7_wlt05"), ExtResource("8_ov2ma"), ExtResource("9_a43ve"), ExtResource("10_x6hq0"), ExtResource("11_vewni"), ExtResource("12_sc3o3"), ExtResource("13_p6aea"), ExtResource("14_55kjb"), ExtResource("15_ibebx"), ExtResource("16_uvtgg")])
exploration_deck = Array[ExtResource("17_muspt")]([ExtResource("18_smtlg"), ExtResource("18_smtlg"), ExtResource("18_smtlg"), ExtResource("19_a5r0e"), ExtResource("19_a5r0e"), ExtResource("19_a5r0e"), ExtResource("20_ij338"), ExtResource("20_ij338"), ExtResource("21_jnc4j"), ExtResource("21_jnc4j"), ExtResource("22_6xcos"), ExtResource("23_rewrk"), ExtResource("24_6volu"), ExtResource("25_jwiqm"), ExtResource("26_yim71"), ExtResource("27_808q8"), ExtResource("27_808q8"), ExtResource("28_780l5")])
objectives = Array[ExtResource("30_0hr58")]([SubResource("Resource_6vmxt"), SubResource("Resource_07mnm"), SubResource("Resource_hb77b")])
