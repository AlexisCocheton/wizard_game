[resource]
script = ExtResource("31_ksdft")
id = &"lvl_07"
display_name = "La forge de Vharn"
act = 4
subtitle = "Six coups pour rien, et il est toujours debout"
intro_text = "Une forge sans forgeron, ou tout ce qui bouge porte une armure. Vharn ne parle pas et ne se presse pas : il encaisse. Tes premiers sorts ne lui feront rien du tout, et il faudra que tu le voies pour le croire."
outro_text = "L Enclume se fend enfin, et dedans il n y a pas de coeur : il y a un contrat, grave dans la fonte, signe par quelqu un qu il n a jamais rencontre. Vharn se croyait le commanditaire. Il etait un outil de plus dans son propre atelier."
intro_story = &""
outro_story = &""
terrain = "grass"
backdrop = "act3_demon"
waves = Array[ExtResource("32_raevg")]([SubResource("Resource_wlt05"), SubResource("Resource_ov2ma"), SubResource("Resource_a43ve"), SubResource("Resource_x6hq0"), SubResource("Resource_vewni"), SubResource("Resource_sc3o3")])
