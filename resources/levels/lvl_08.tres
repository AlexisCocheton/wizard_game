[resource]
script = ExtResource("22_u7xm8")
id = &"lvl_08"
display_name = "La route du maire"
act = 1
subtitle = "Ce n est pas la foret qui est attaquee"
intro_text = "Le maire s est tu pendant des mois. Ce n est pas Nuri qui 
tombe, c est toute l ile, et ca vient d en haut. Entre la grange et la clairiere, la 
route grouille : des gelees qui se coupent en deux, des ruches qui eclatent. Frappe 
large ou ne frappe pas."
outro_text = "Au bout de la route, une carcasse de dirigeable coincee dans 
les arbres. Elle fume encore, et quelque chose tape dedans avec un outil. Loin 
derriere, dans la foret, quelque chose de tres grand se met debout."
intro_story = &"lvl_08_intro"
outro_story = &"lvl_08_outro"
terrain = "grass"
backdrop = "act1_sky"
waves = Array[ExtResource("23_uyy03")]([SubResource("Resource_hw4m0"), SubResource("Resource_w76i7"), SubResource("Resource_3ysf2"), SubResource("Resource_lckoi")])
enemy_pool = Array[ExtResource("1_hw4m0")]([ExtResource("2_w76i7"), ExtResource("3_3ysf2"), ExtResource("4_lckoi"), ExtResource("5_wd4fe"), ExtResource("6_u5o4w"), ExtResource("7_wrnir"), ExtResource("8_mlu4c"), ExtResource("9_rxygd"), ExtResource("10_1ap0e")])
