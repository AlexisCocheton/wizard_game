[resource]
script = ExtResource("22_u7xm8")
id = &"lvl_08"
display_name = "La route du maire"
act = 1
subtitle = "Ce n est pas la foret qui est attaquee"
intro_text = "Le maire s est tu pendant des mois. Ce n est pas Nuri qui tombe, c est toute l ile, et ca vient d en haut. Entre la grange et la clairiere, la route grouille : des gelees qui se coupent en deux, des ruches qui eclatent. Frappe large ou ne frappe pas."
