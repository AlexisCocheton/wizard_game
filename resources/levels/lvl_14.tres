[resource]
script = ExtResource("26_ave5e")
id = &"lvl_14"
display_name = "La galerie des saisons"
act = 5
subtitle = "Ce qui a deja ete efface, expose"
intro_text = "Il n y a pas de sol. Il y a une galerie, et dans la galerie tout ce que tu as deja tue, range par saison. Le Gardien de la foret est dans une vitrine, et il y en a deux."
outro_text = "Personne n est venu defendre la galerie. On te laisse passer d une salle a l autre comme on laisse passer un visiteur. L enfant ne dit plus rien depuis le pentacle, et il marche devant."
