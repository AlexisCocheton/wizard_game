[resource]
script = ExtResource("23_f1k8d")
id = &"lvl_15"
display_name = "Le registre"
act = 5
subtitle = "Ton nom y est, avec une date"
intro_text = "Des colonnes de noms qui montent plus haut que le regard. Ce n est pas une liste de morts : c est un CALENDRIER. L humanite n a pas ete attaquee, elle etait programmee pour s eteindre, a la date prevue. Ta ligne est la, et la date a ete raturee une fois."
outro_text = "Chronos n etait pas un ennemi, c etait un employe. Il portait les dates. Ton retour en arriere n a inquiete personne ici : il les a AMUSES. Un pion qui recule, c est la premiere chose distrayante depuis des eons, et on t a laisse courir pour voir jusqu ou tu irais."
intro_story = &"lvl_15_intro"
outro_story = &"lvl_15_outro"
terrain = "sand"
backdrop = "act5_divine"
waves = Array[ExtResource("24_xq181")]([SubResource("Resource_vq7pw"), SubResource("Resource_25elf"), SubResource("Resource_j8o81"), SubResource("Resource_dchlc"), SubResource("Resource_23yof")])
enemy_pool = Array[ExtResource("1_23yof")]([ExtResource("2_w28dl"), ExtResource("3_sc6yj"), ExtResource("4_bilc3"), ExtResource("5_xajwd"), ExtResource("6_6s48e"), ExtResource("7_gvwmy"), ExtResource("8_4hx7v"), ExtResource("9_dchlc")])
