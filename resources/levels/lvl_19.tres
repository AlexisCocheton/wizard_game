[resource]
script = ExtResource("20_5pmol")
id = &"lvl_19"
display_name = "Les fosses basses"
act = 3
subtitle = "Ce qui remonte les barres de vie"
intro_text = "Tombol commence par le bas : des fosses ouvertes ou l on avance dans l eau. Les Pretres goules y soignent tout ce qui marche, et ils se soignent entre eux. Contre eux, frapper fort et frapper juste sont deux choses differentes."
outro_text = "Le Roi squelette est passe ici il y a moins d une heure — l eau des fosses est encore trouble de son sillage. Il n a pas laisse un piege : il a laisse une GARDE, et une garde ne protege pas un fuyard, elle retarde un poursuivant."
intro_story = &"lvl_19_intro"
outro_story = &"lvl_19_outro"
terrain = "sand"
backdrop = "act2_graveyard"
waves = Array[ExtResource("21_6yfmp")]([SubResource("Resource_28m2p"), SubResource("Resource_vwleu"), SubResource("Resource_ulbwl"), SubResource("Resource_21pon")])
enemy_pool = Array[ExtResource("1_21pon")]([ExtResource("2_cvq5j"), ExtResource("3_2c7cs"), ExtResource("4_3hnwq"), ExtResource("5_vsqve"), ExtResource("6_8ejf3"), ExtResource("7_e4vxr")])
exploration_deck = Array[ExtResource("8_rffqt")]([ExtResource("9_doijp"), ExtResource("9_doijp"), ExtResource("9_doijp"), ExtResource("13_ah3ht"), ExtResource("13_ah3ht"), ExtResource("13_ah3ht"), ExtResource("12_yfv8l"), ExtResource("12_yfv8l"), ExtResource("12_yfv8l"), ExtResource("11_pvtfm"), ExtResource("11_pvtfm"), ExtResource("10_epw7l"), ExtResource("10_epw7l"), ExtResource("15_wokui"), ExtResource("15_wokui")])
objectives = Array[ExtResource("19_ckdo4")]([SubResource("Resource_6vmxt"), SubResource("Resource_07mnm"), SubResource("Resource_hb77b")])
legendary_reward = ExtResource("18_elph3")
next_levels = Array[StringName]([&"lvl_20"])
