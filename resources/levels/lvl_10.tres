[resource]
script = ExtResource("24_g86xn")
id = &"lvl_10"
display_name = "Les fosses de Sesh"
act = 4
subtitle = "Tout ce que tu laisses vivre, il le mange"
intro_text = "Des fosses tiedes ou le sol remue. Sesh ne commande a rien : il a FAIM, et ses sujets sont ce qui n a pas encore ete avale. Ce que tu laisses derriere toi ne t attend pas, il le nourrit."
outro_text = "Sesh creve comme une outre, et ce qu il avait avale ressort intact et vivant. Sur son flanc, la meme plaque de metal noir que dans la poitrine du Gardien. Il n a jamais donne d ordre a personne : il en a recu un."
intro_story = &"lvl_10_intro"
outro_story = &"lvl_10_outro"
terrain = "grass"
backdrop = "act3_demon"
waves = Array[ExtResource("25_1r1p4")]([SubResource("Resource_l5tjt"), SubResource("Resource_ntw4e"), SubResource("Resource_xfs5l"), SubResource("Resource_c4pak"), SubResource("Resource_3t80o")])
enemy_pool = Array[ExtResource("1_c4pak")]([ExtResource("2_3t80o"), ExtResource("3_1maxx"), ExtResource("4_038uy"), ExtResource("5_xnxle"), ExtResource("6_cdd3h"), ExtResource("7_13lwu"), ExtResource("8_j06ms"), ExtResource("9_vac0b"), ExtResource("10_w2mk4"), ExtResource("11_r352n")])
exploration_deck = Array[ExtResource("12_6t36y")]([ExtResource("14_5g66q"), ExtResource("14_5g66q"), ExtResource("14_5g66q"), ExtResource("14_5g66q"), ExtResource("16_74qp1"), ExtResource("16_74qp1"), ExtResource("16_74qp1"), ExtResource("16_74qp1"), ExtResource("13_nwen4"), ExtResource("13_nwen4"), ExtResource("13_nwen4"), ExtResource("21_vvwhi"), ExtResource("21_vvwhi"), ExtResource("20_fnnop"), ExtResource("18_l5tjt")])
