[resource]
script = ExtResource("26_1l5ws")
id = &"lvl_16"
display_name = "Le siege vide"
act = 5
subtitle = "Il est vide depuis toujours"
intro_text = "Au bout du registre, un siege. Il est vide depuis toujours, et 
personne ne le garde. Ce qui descend vers toi, l enfant l envoie sans y penser : des 
adversaires qui ont ferme des actes entiers arrivent par trois, sans un nom."
outro_text = "L enfant lache ta main. Il ne grandit pas, il ne change pas de 
forme : il arrete simplement de faire semblant d avoir peur. Il etait la depuis la 
date — c est lui qui l avait posee. Nuri le sixieme jour, Nox la septieme nuit. Et 
quand tu as recule, pour la premiere fois depuis tres longtemps, il n a pas su ce qui 
allait arriver."
intro_story = &"lvl_16_intro"
outro_story = &"lvl_16_outro"
terrain = "sand"
backdrop = "act5_divine"
waves = Array[ExtResource("27_noohh")]([SubResource("Resource_iqwbf"), SubResource("Resource_0beht"), SubResource("Resource_pegq6"), SubResource("Resource_00s4r")])
enemy_pool = Array[ExtResource("1_phey4")]([ExtResource("2_v27ae"), ExtResource("5_0beht"), ExtResource("6_pegq6"), ExtResource("7_00s4r"), ExtResource("8_fn1rf"), ExtResource("9_k3q17"), ExtResource("10_h83vr"), ExtResource("11_4s603"), ExtResource("12_0beht"), ExtResource("13_pegq6"), ExtResource("14_00s4r"), ExtResource("15_fn1rf"), ExtResource("14_phey4"), ExtResource("15_1uh55"), ExtResource("16_v27ae")])
