[resource]
script = ExtResource("17_b1aig")
id = &"side_a2_atelier"
display_name = "L atelier du rat"
act = 2
subtitle = "Vingt ans d etabli, et un oeil d or"
intro_text = "Le rat a travaille vingt ans dans un atelier des Sky Lands, sur l ile voisine. Ce qui garde la porte aujourd hui est un oeil d or de son modele : il voit venir tes sorts, en esquive une partie et appelle d autres yeux autour de lui. Couvre le ciel."
