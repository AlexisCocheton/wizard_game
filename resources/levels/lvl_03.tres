[resource]
script = ExtResource("23_ldkuw")
id = &"lvl_03"
display_name = "L ossuaire de bordure"
act = 2
subtitle = "Une administration, pas un cimetiere"
intro_text = "Passe le port, les iles ne portent plus que des tombes, rangees et numerotees. Ici les morts sont tries et comptes, et les Pretres goules tiennent les registres. On ne pleure pas les morts de l ossuaire : on les compte."
