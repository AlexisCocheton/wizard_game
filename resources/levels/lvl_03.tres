[resource]
script = ExtResource("23_ldkuw")
id = &"lvl_03"
display_name = "Ossuaire des Marees"
act = 2
subtitle = "Une administration, pas un cimetiere"
intro_text = "Ici les morts sont tries, comptes, reaffectes. Les Pretres goules tiennent les registres et leur ile se vide : les ames partent ailleurs. Ils n ont pas efface ton royaume par haine. Ils l ont fait pour le STOCK."
outro_text = "Une Gelee prisonniere d un cercle de sel t a regarde la liberer, puis t a montre comment un corps se separe et se rassemble. Les registres, eux, sont clairs : l extinction humaine devait alimenter une Grande Invocation."
terrain = "sand"
waves = Array[ExtResource("24_8xb40")]([SubResource("Resource_jdm2l"), SubResource("Resource_xe4qr"), SubResource("Resource_3r5vv"), SubResource("Resource_gcv4q"), SubResource("Resource_m4lyl"), SubResource("Resource_ea3af")])
