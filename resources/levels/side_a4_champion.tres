act = 4
subtitle = "L arene vide garde son meilleur combattant"
intro_text = "Kaltek est tombe, son arene est restee. Au centre, son champion en armure d or casse sa chaine. Il accelere a chaque coup recu et se releve une fois : frappe-le peu, mais fort, et ralentis-le."
