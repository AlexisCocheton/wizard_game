; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wizard Story"
config/description="Roguelike defender deck-building en temps reel, mobile portrait."
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
SaveData="*res://scripts/autoload/save_data.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
EffectRegistry="*res://scripts/autoload/effect_registry.gd"
SpeedGauge="*res://scripts/autoload/speed_gauge.gd"
RunState="*res://scripts/autoload/run_state.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
AudioBus="*res://scripts/autoload/audio_bus.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
